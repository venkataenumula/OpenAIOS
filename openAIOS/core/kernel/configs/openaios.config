# Open AI OS kernel configuration fragment
# Goal: Debian minimal + container-first + GPU/AI workload optimized
# This is a CONFIG FRAGMENT, not a full .config.
# Merge with the current Debian kernel config using scripts/merge-config.sh.

# ------------------------------------------------------------
# Core container support
# ------------------------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_SCHED=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CPUSETS=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_TMPFS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KEYS=y
CONFIG_CHECKPOINT_RESTORE=y

# ------------------------------------------------------------
# eBPF / observability / networking hooks
# ------------------------------------------------------------
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m
CONFIG_BPF_EVENTS=y
CONFIG_KPROBES=y
CONFIG_UPROBES=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_TRACEPOINTS=y
CONFIG_PERF_EVENTS=y

# ------------------------------------------------------------
# AI memory and performance features
# ------------------------------------------------------------
CONFIG_HUGETLBFS=y
CONFIG_HUGETLB_PAGE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_NUMA=y
CONFIG_NUMA_BALANCING=y
CONFIG_MMU_NOTIFIER=y
CONFIG_MEMORY_FAILURE=y
CONFIG_COMPACTION=y
CONFIG_KSM=y
CONFIG_ZSWAP=y
CONFIG_ZRAM=m

# ------------------------------------------------------------
# High performance I/O and model loading
# ------------------------------------------------------------
CONFIG_IO_URING=y
CONFIG_AIO=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_NVME_MULTIPATH=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=m
CONFIG_DM_THIN_PROVISIONING=m
CONFIG_DM_SNAPSHOT=m
CONFIG_XFS_FS=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=m
CONFIG_FUSE_FS=m
CONFIG_VIRTIO_FS=m

# ------------------------------------------------------------
# GPU / accelerator readiness
# Vendor GPU drivers are expected as external/vendor modules.
# Keep kernel primitives required by NVIDIA/AMD/Intel GPU stacks.
# ------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_ACCEL=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_IOVA=y
CONFIG_AMD_IOMMU=y
CONFIG_INTEL_IOMMU=y
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
CONFIG_PCI_IOV=y
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m
CONFIG_VFIO_IOMMU_TYPE1=m
CONFIG_HMM_MIRROR=y
CONFIG_ZONE_DEVICE=y
CONFIG_DEVICE_PRIVATE=y
CONFIG_DEVICE_PUBLIC=y

# ------------------------------------------------------------
# AI networking / service mesh / secure overlay networking
# ------------------------------------------------------------
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_FIB_INET=m
CONFIG_BRIDGE=m
CONFIG_VETH=m
CONFIG_VXLAN=m
CONFIG_GENEVE=m
CONFIG_WIREGUARD=m
CONFIG_TUN=m
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_DUMMY=m

# ------------------------------------------------------------
# Security hardening
# ------------------------------------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_INTEGRITY=y
CONFIG_INTEGRITY_SIGNATURE=y
CONFIG_IMA=y
CONFIG_IMA_APPRAISE=y
CONFIG_EVM=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y

# ------------------------------------------------------------
# TPM / measured boot / appliance readiness
# ------------------------------------------------------------
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y

# ------------------------------------------------------------
# Virtualization/cloud support: keep useful for VMware/AWS/Azure/GCP
# ------------------------------------------------------------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=m
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_SCSI=m
CONFIG_VMWARE_VMCI=m
CONFIG_VMW_PVSCSI=m
CONFIG_VMXNET3=m
CONFIG_HYPERV=m
CONFIG_HYPERV_NET=m
CONFIG_HYPERV_STORAGE=m
CONFIG_NET_VENDOR_AMAZON=y
CONFIG_ENA_ETHERNET=m

# ------------------------------------------------------------
# Disable legacy / small-footprint features
# ------------------------------------------------------------
CONFIG_FLOPPY=n
CONFIG_PARPORT=n
CONFIG_PRINTER=n
CONFIG_ISDN=n
CONFIG_ATM=n
CONFIG_IPX=n
CONFIG_ATALK=n
CONFIG_DECNET=n
CONFIG_REISERFS_FS=n
CONFIG_JFS_FS=n
CONFIG_HFS_FS=n
CONFIG_HFSPLUS_FS=n
CONFIG_UDF_FS=n
CONFIG_CRAMFS=n
CONFIG_ROMFS_FS=n
CONFIG_MINIX_FS=n
